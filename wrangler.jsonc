{
  // Cloudflare: Worker (worker/index.js) + statiske filer i dist/ (lages av build.py)
  "name": "fjellhamar-bistro",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Bare disse går via Worker-en: sider med innhold fra admin, og admin selv (krever innlogging).
    // Bilder, CSS osv. serveres direkte.
    "run_worker_first": ["/", "/index", "/index.html", "/meny", "/meny.html", "/julemeny", "/julemeny.html", "/gavekort", "/gavekort.html", "/assets/js/site-data.js", "/assets/js/menu-data.js", "/admin", "/admin/*", "/api/*"]
  },
  // Sidemalene fra build/templates importeres som tekst
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }],

  // ---- LIVE (main) ----
  // Ekte innhold som kunden endrer i admin
  "kv_namespaces": [{ "binding": "CONTENT", "id": "1c5b72ae71554106af8f177f1148e9a7" }],
  // Innlogging (Cloudflare Access-appen «Fjellhamar Bistro admin»). Tomt = admin er stengt.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "winter-surf-d9ec.cloudflareaccess.com",
    "ACCESS_AUD": "f2a3271b6721ed03ee3b5019916c21200e5057a3cd98a5f8e3556dd95b10d7e6"
  },

  // ---- FORHÅNDSVISNINGER (admin-branchen o.l.) – går aldri live, og bruker egne testdata ----
  "previews": {
    "kv_namespaces": [{ "binding": "CONTENT", "id": "2c88cd319fe0434ca8f049c4688c23fe" }],
    // Innlogging for forhåndsvisninger (Cloudflare Access: «Previews only»)
    "vars": {
      "ACCESS_TEAM_DOMAIN": "winter-surf-d9ec.cloudflareaccess.com",
      "ACCESS_AUD": "00f45ea88eee3340a903fdfe1696ca9ee930e42e390a862a7ac3715b0e6d569a"
    }
  }
}
